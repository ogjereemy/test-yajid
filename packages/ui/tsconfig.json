{
  "extends": "../tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist",
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],
    "moduleResolution": "node",
    "paths": {
      "@property-right/utils/*": ["../utils/src/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../utils" }]
}